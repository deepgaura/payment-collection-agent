# Copy this file to `.env` and fill in your provider. The agent also runs
# without any key (it falls back to the deterministic rule-based extractor).
# The real `.env` is git-ignored and never committed.

# ---- Option A: Anthropic Claude via Google Vertex (recommended) ----
# Requires `gcloud auth application-default login` for credentials.
LLM_PROVIDER=vertex
ANTHROPIC_VERTEX_PROJECT_ID=your-gcp-project
CLOUD_ML_REGION=europe-west1
ANTHROPIC_MODEL=claude-opus-4-5@20251101

# ---- Option B: OpenAI ----
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# Toggles (defaults shown)
USE_LLM=true
USE_CONVERSATIONAL=true
