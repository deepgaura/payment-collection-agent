# Copy this file to `.env` and fill in your key to enable the LLM extractor.
# The agent also runs without a key (it falls back to the deterministic
# rule-based extractor). The real `.env` is git-ignored and never committed.

OPENAI_API_KEY=
USE_LLM=true

# Optional overrides:
# LLM_MODEL=gpt-4o-mini
